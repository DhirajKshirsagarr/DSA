                <mxCell id="22" value="(n-1,m-1)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#d6b656;overflow=hidden;fillColor=#fff2cc;top=1;left=1;bottom=1;right=1;pointerEvents=1;" vertex="1" parent="18">
                    <mxGeometry x="180" width="60" height="60" as="geometry">
                        <mxRectangle width="60" height="60" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="29" value="" style="endArrow=classic;html=1;" edge="1" parent="1">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="170" y="-1010" as="sourcePoint"/>
                        <mxPoint x="230" y="-1010" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="30" value="" style="endArrow=classic;html=1;" edge="1" parent="1">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="150" y="-1000" as="sourcePoint"/>
                        <mxPoint x="150" y="-950" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="31" value="&lt;font style=&quot;font-size: 23px;&quot;&gt;f(n,m,i,j)=f(n,m,i+1,j)+&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;f(n,m,i,j+1)&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;font-size: 23px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;div&gt;&lt;font style=&quot;font-size: 23px;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;cell ka just rigth ke cell ke ways + just down wale&amp;nbsp; sell ke ways&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="410" y="-1010" width="395" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="32" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;but it&#39;s time complexity is O(2^n+m)&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;which is very high&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="450" y="-870" width="290" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="33" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;so we use alternative way which is permuntation&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;for going rigth thire are (m-1) cells&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;for going down thir are (n-1) cells&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;it is like string &quot;RRDDRDR&quot;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;we simply have to find permuntation of string&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;so&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;total no. of wayes to arrane string=&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;(m-1+n-1)! / ((n-1)!(m-1)!)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" style="text;align=center;fillColor=#ffcc99;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=#36393d;" vertex="1" parent="1">
                    <mxGeometry x="310" y="-760" width="360" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="34" value="then TC=O(n+m)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="410" y="-580" width="110" height="30" as="geometry"/>
                </mxCell>
            </root>
